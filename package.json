{
  "name": "meyra",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api": "npm run dev -w apps/api",
    "web": "npm run dev -w apps/web",
    "seed": "npm run seed -w apps/api",
    "dev": "npm run db:up && concurrently -n api,web -c yellow,cyan \"npm run api\" \"npm run web\"",
    "deploy": "vercel deploy --prod"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
