PORT=4000
DATABASE_URL=postgres://meyra:meyra@localhost:5436/meyra
JWT_SECRET=change-me-in-production
# Public https URL of this server (used for the payment return page). e.g. https://app.meyraglory.com
PUBLIC_URL=

# Everything below is optional. Leave blank to run that feature in test mode.

# --- Razorpay (dashboard.razorpay.com → Settings → API Keys / Webhooks) ---
# Webhook URL: https://<your-domain>/api/webhooks/razorpay  events: payment_link.paid, payment_link.expired, payment_link.cancelled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS via MSG91 (DLT-approved templates needed) ---
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_FLOW_TEMPLATE_ID=      # generic template with a ##message## variable, for order/shipping SMS
MSG91_SENDER_ID=
# Testing only: fixed OTP for phone login while no SMS provider is set (anyone can then log in as any phone number).
# Remove before real customers. Ignored automatically once MSG91 keys are set.
FIXED_TEST_OTP=

# --- Email via SMTP, e.g. smtps://user:pass@smtp.zoho.in:465 ---
SMTP_URL=
MAIL_FROM=Meyra <no-reply@meyraglory.com>

# --- Live GSTIN lookup (any GSP/aggregator that returns JSON for GET <url><GSTIN>) ---
GST_LOOKUP_URL=
GST_LOOKUP_KEY=
GST_LOOKUP_HEADER=x-api-key

# --- Shiprocket ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# --- S3 / Cloudflare R2 / DigitalOcean Spaces ---
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=                 # only for R2/Spaces, e.g. https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_URL=               # public base URL for the bucket (CDN / r2.dev domain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
